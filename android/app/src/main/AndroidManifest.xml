<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 跟读/听写：麦克风录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 联网下载模型（Vosk zip / 在线源）。debug/profile 由 Flutter 模板自动加，
         但 release 主 manifest 必须显式声明，否则 DNS 解析直接被拒
         （真机表现 SocketException: Failed host lookup，易误判为网络问题）。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="智启陪读"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- llama OpenCL GPU 加速：声明加载系统 vendor 的 OpenCL 驱动（Adreno）。
             required=false —— 设备无 OpenCL 驱动时 app 照常运行（引擎回落 CPU）。
             API 26+ 支持；minSdk 26 匹配。 -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- 包可见性声明（Android 11+ / API 30+ 必需）：
         不声明则 App 检视不到系统里的其他包，TTS 引擎绑定必失败。
         真机签名：TTS onInit=-1 + getDefaultEngine()=null + speak 返回 -1，
         与 speak_reader 相比仅差此声明（其 manifest 声明后同一引擎正常）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher：允许查询可处理 https 链接的浏览器 Activity（Android 11+ 包可见性） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
